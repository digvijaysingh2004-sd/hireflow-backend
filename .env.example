# ==============================================================================
# HireFlow — Master Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual values.
# DO NOT COMMIT THE REAL .env FILE TO GITHUB!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection Strings (PostgreSQL)
# Local: Host=localhost;Port=5432;Database=hireflow_identity;Username=postgres;Password=your_password
# Render/Neon: postgresql://username:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require
# ------------------------------------------------------------------------------
ConnectionStrings__IdentityDatabase=Host=localhost;Port=5432;Database=hireflow_identity;Username=postgres;Password=change_me_locally
ConnectionStrings__HiringDatabase=Host=localhost;Port=5432;Database=hireflow_hiring;Username=postgres;Password=change_me_locally
ConnectionStrings__NotificationDatabase=Host=localhost;Port=5432;Database=hireflow_notification;Username=postgres;Password=change_me_locally

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Distributed Cache & Rate Limiting)
# Upstash: relevant-civet-xyz.upstash.io:6379,password=YOUR_UPSTASH_PASSWORD,ssl=True,abortConnect=False
# ------------------------------------------------------------------------------
Redis__ConnectionString=

# ------------------------------------------------------------------------------
# 3. JWT Security & Auth
# ------------------------------------------------------------------------------
Jwt__Issuer=https://hireflow-identity.onrender.com
Jwt__Audience=https://hireflow-hiring.onrender.com
Jwt__SigningKey=hireflow_super_secret_jwt_key_for_local_development_1234567890!
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ------------------------------------------------------------------------------
# 4. Email / SMTP Configuration (Gmail App Password)
# ------------------------------------------------------------------------------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=your-email@gmail.com
Smtp__Password=your-16-char-google-app-password
Smtp__SenderEmail=your-email@gmail.com
Smtp__SenderName=HireFlow Notifications

# ------------------------------------------------------------------------------
# 5. Cloud Observability (Honeycomb.io OpenTelemetry)
# ------------------------------------------------------------------------------
Honeycomb__ApiKey=
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io

# ------------------------------------------------------------------------------
# 6. Inter-Service & Frontend Origin
# ------------------------------------------------------------------------------
Frontend__Origin=http://localhost:5173
Identity__BaseUrl=http://localhost:5218
Notification__BaseUrl=http://localhost:5289
