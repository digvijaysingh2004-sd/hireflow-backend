# HireFlow Environment Configuration
# Copy this file to .env and modify according to your setup.

# ========================================================
# 1. Local PostgreSQL (Docker vs Native)
# ========================================================
# If running native Windows PostgreSQL:
# IDENTITY_DB_CONNECTION=Host=localhost;Port=5432;Database=hireflow_identity;Username=postgres;Password=your_local_postgres_password
#
# If running Docker Compose (mapped to port 5433 by default to avoid port collision with local Postgres):
# POSTGRES_PORT=5433
IDENTITY_DB_CONNECTION=Host=localhost;Port=5432;Database=hireflow_identity;Username=postgres;Password=change_me_locally
HIRING_DB_CONNECTION=Host=localhost;Port=5432;Database=hireflow_hiring;Username=postgres;Password=change_me_locally
NOTIFICATION_DB_CONNECTION=Host=localhost;Port=5432;Database=hireflow_notification;Username=postgres;Password=change_me_locally

# ========================================================
# 2. JWT Configuration
# ========================================================
JWT_ISSUER=HireFlow.Identity
JWT_AUDIENCE=HireFlow.Api
JWT_SIGNING_KEY=hireflow_super_secret_jwt_key_for_local_development_1234567890!
JWT_ACCESS_TOKEN_MINUTES=15

# ========================================================
# 3. Mail & Frontend
# ========================================================
SMTP_HOST=localhost
SMTP_PORT=1025
FRONTEND_ORIGIN=http://localhost:5173
