# Auto detect text files and perform line ending normalization
* text=auto

# Ensure consistent line endings for source code and documents
*.cs text
*.json text
*.http text
*.md text
*.yml text
*.yaml text
*.sql text
*.xml text
*.props text
*.targets text

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
